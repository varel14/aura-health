PORT=4000
PGHOST=/run/postgresql
PGPORT=5432
PGDATABASE=aura_health
PGUSER=varel
DEMO_PIN=1234

# Fournisseur IA — analyse de symptômes et compte-rendu de consultation.
# AI_PROVIDER sélectionne groq ou glm (tous deux compatibles OpenAI) ; sans
# clé API, les deux flux basculent sur le moteur de règles local.
AI_PROVIDER=groq

# Groq — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# GLM (Zhipu) — https://open.bigmodel.cn
GLM_API_KEY=
GLM_MODEL=glm-4.6
