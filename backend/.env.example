# 4000 est souvent pris par un autre projet de ce poste — l'API démarre sur 4001
# (mobile/.env pointe EXPO_PUBLIC_API_URL vers la même valeur).
PORT=4001
PGHOST=/run/postgresql
PGPORT=5432
PGDATABASE=aura_health
PGUSER=varel
DEMO_PIN=1234

# Fournisseur IA — analyse de symptômes et compte-rendu de consultation.
# AI_PROVIDER sélectionne groq ou glm (tous deux compatibles OpenAI) ; sans
# clé API, les deux flux basculent sur le moteur de règles local.
AI_PROVIDER=groq

# Groq — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# GLM (Zhipu) — https://open.bigmodel.cn
GLM_API_KEY=
GLM_MODEL=glm-4.6
